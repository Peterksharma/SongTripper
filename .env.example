# SongTripper server configuration — copy to .env and fill in.

# Port the API listens on
PORT=3000

# Reverse-proxy hops to trust for client IPs (0 = directly exposed;
# 1 = behind a single proxy such as Railway/nginx). Wrong value = rate
# limiter throttles everyone together or can be spoofed.
TRUST_PROXY_HOPS=0

# OpenCage reverse-geocoding API key  (https://opencagedata.com/dashboard)
LOCATION_KEY=

# Contact email — MusicBrainz requires one in the User-Agent header
EMAIL=you@example.com

# Spotify app credentials  (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only needed for the future-facing user OAuth routes (/api/spotify/*)
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Redis — `docker compose up -d` starts one here; optional (server degrades
# gracefully without it)
REDIS_URL=redis://localhost:6379

# Postgres — leave empty to use local defaults (current OS user, database
# "songtripper"); optional (server runs without persistence if unreachable)
DATABASE_URL=
